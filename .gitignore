# macOS
.DS_Store

# Local backups of pre-1.1 originals (not part of the package)
.attic/

# Internal handoff notes: contains personal paths, scrub before publishing
NEXT-SESSION.md

# Claude Code machine-local state. A project .claude/settings.json or
# .claude/skills/ can still be committed deliberately; these cannot.
.claude/settings.local.json
.claude/worktrees/

# The 4K capture rig lives on the demo/capture branch, not here. This keeps a
# stray checkout of it from ever being staged into a commit on main. Files
# already tracked on that branch are unaffected: .gitignore does not apply to
# tracked paths.
demo/

# Render output, if the rig is ever run from inside the repo
.spoolr-demo/

# Python bytecode cache
__pycache__/
*.pyc
